# Plantilla para un servidor sin Docker (hosting compartido o VPS). Copia a .env y completa.
APP_NAME="Kidu Baby Tracker"
APP_ENV=production
APP_KEY=            # php artisan key:generate --force
APP_DEBUG=false     # nunca true en producción
APP_URL=https://tu-dominio.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sin Redis: sesiones, caché y cola en la base de datos (las tablas las crea `php artisan migrate`).
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log

# Avisos push: php artisan webpush:vapid --write (necesitan HTTPS)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@example.com
